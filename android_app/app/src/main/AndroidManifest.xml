<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptics for MC_mdaVibrator (game vibration setting). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      TCP sockets for the WIPI net API (MC_netSocket/Connect/Send/Recv), used by
      the game's online features (복구 / 네트워크 창고 / 캐시샵 / 오브 결합).
      Raw sockets from native code need only INTERNET; usesCleartextTraffic
      governs the Java HTTP stacks (URLConnection/WebView), not AF_INET sockets,
      so it is deliberately not set.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false: the app-private dir holds `wie_account_id`, and in the
      current account model that 16-byte value IS the credential for the private
      server (warehouse, recovery backups). Letting it ride along in adb/cloud
      backups puts it somewhere the user does not expect it to be. Saves are the
      game's own `.dat` files in the same dir, so this also stops a restore from
      silently resurrecting another install's character.
    -->
    <!--
      런처 아이콘/이름 = 원작 **영웅서기2**. icon/roundIcon 이 없던 동안에는 안드로이드
      기본 플레이스홀더 아이콘이 떴다. 아이콘 리소스는 tools/gen_app_icon.py 가
      원작 타이틀 아트에서 생성한다(adaptive icon, mipmap-anydpi-v26).

      ★ 2026-09-01: 이 주석은 원래 "원작 영웅서기3" 이었고, 그게 사실이었다 — 포크가
      hero3 의 PNG 를 그대로 들고 왔고 `tools/gen_app_icon.py` 는 넘어오지도 않아서,
      두 앱을 같이 깐 기기에서 영웅서기2 와 3 의 아이콘이 똑같았다(사용자 보고).
      이제 그 스크립트가 이 저장소에 있고, 게임 아카이브의 `img/sui` 3번 프레임
      (169x87 타이틀 로고)에서 직접 생성하므로 아이콘이 게임과 다시 어긋날 수 없다.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true">

        <!--
          ★ 2026-09-18: 릴리스 빌드를 `simpleperf` 로 프로파일할 수 있게 한다.

          이 앱의 프레임 예산은 **에뮬레이터 스레드의 호스트 시간**이 쓴다(게스트 명령이
          아니라 host↔guest 경계). wie_probe 의 프로파일 플래그는 원리적으로 게스트 PC 만
          샘플링하므로 그 시간을 볼 수 없고(CLAUDE.md 「#9 호스트 프로파일러」), 디버그
          APK 로 재는 것은 다른 빌드를 재는 것이다. 이 한 줄이면 adb 셸의 simpleperf 가
          **출시와 같은 릴리스 .so** 를 잰다.

          ⚠ XML 주석 안에는 하이픈 두 개를 쓸 수 없다 — 플래그 이름을 그대로 적었다가
          `processReleaseMainManifest` 가 파싱에서 죽었다 (2026-09-18).

          `android:shell="true"` 는 adb 셸에게만 프로파일링을 허용한다(Android 10+).
          디버깅을 여는 것이 아니고 앱 데이터를 읽히지도 않는다 — Play 로 배포되는
          게임들이 같은 목적으로 다는 속성이다.
        -->
        <profileable android:shell="true" />

        <!--
          ★ 2026-10-02 세이브 옮기기: 「보내기」 hands the transfer file to the share sheet
          (KakaoTalk, Quick Share, Drive …) through this provider: read only, and only for the
          one file the intent names (grantUriPermissions, no export). It can serve nothing but
          the cache folder res/xml/save_share_paths.xml maps, where MainActivity.exportToCache
          makes that file. The authority suffix is MainActivity.SAVE_SHARE_AUTHORITY.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.saveshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/save_share_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">

            <!-- GameActivity loads the native library named here (libmain.so). -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
